#!/usr/bin/env bash

set -euo pipefail

option="${1:-}"

venv_root=".venv"
# Not cargo: rust/'s rust-toolchain.toml pins the Rust toolchain, which only rustup honours
# (require_rustup).
os_packages="python3-tk"
rust_crate_root="rust"
# Pinned here, not in requirements.txt (a pip-compile lock of the package's own dependencies):
# the build tool for rust/, so CI's cached venv and wheel and a local setup all build with the
# same maturin. Bump deliberately, then rebuild and re-run both test suites.
maturin_version="1.15.0"
# Pinned for the same reason, and because ruff's default rule set changes between releases:
# local and CI lint against the same rules. Bump deliberately, fixing whatever the new rules report.
ruff_version="0.16.9"

clean () {

    rm -rf .pytest_cache
    rm -rf indrajala_ml/__pycache__
    rm -rf indrajala_ml/demos/__pycache__
    rm -rf tests/__pycache__
}

install_os_packages () {

    echo "installing os packages ..."
    sudo apt-get install -y $os_packages
    echo "... installed os packages"
}

create_venv () {

    echo "creating virtual environment @ $venv_root ..."
    python3 -m venv "$venv_root"
    echo "... created virtual environment @ $venv_root"
}

init_submodules () {

    echo "initializing git submodules ..."
    git submodule update --init --recursive
    echo "... initialized git submodules"
}

activate_venv () {

    source "$venv_root/bin/activate"
    echo "$(python --version) venv @ $(which python)"
}

deactivate_venv () {

    deactivate
}

install_and_upgrade_pip () {

    python -m pip install --upgrade pip
    echo "$(python -m pip --version)"
}

install_python_modules () {

    echo "installing python modules ..."
    python -m pip install -r requirements.txt
    echo "... installed python modules"
}

install_ruff () {

    echo "installing ruff ..."
    python -m pip install "ruff==$ruff_version"
    echo "... installed ruff"
}

install_maturin () {

    echo "installing maturin ..."
    python -m pip install "maturin==$maturin_version"
    echo "... installed maturin"
}

fetch_data () {

    echo "fetching datasets ..."
    python scripts/fetch_datasets.py
    echo "... fetched datasets"
}

require_rustup () {

    if ! command -v rustup >/dev/null 2>&1; then
        echo "rustup not found: install it from https://rustup.rs (rust/rust-toolchain.toml pins the toolchain)" >&2
        exit 1
    fi
}

build_rust () {

    require_rustup
    echo "building $rust_crate_root ..."
    # --release, not a plain debug build: a debug build of this crate measures 65-427x slower
    # than numpy on the same forward pass a release build only measures 2-10x slower on.
    (cd "$rust_crate_root" && maturin develop --release)
    echo "... built $rust_crate_root"
}

install_rust_wheel () {

    # $1: a wheel directory CI caches, keyed on the rust/ submodule commit - most PRs don't move
    # the submodule, so they reinstall the cached wheel instead of recompiling the crate (8-24 s
    # measured per job). Empty directory (cache miss): build the wheel into it first.
    # --force-reinstall: the wheel's version is always 0.1.0, and the cached venv may already
    # hold an older build of it.
    local wheel_dir="$1"
    if ! ls "$wheel_dir"/*.whl >/dev/null 2>&1; then
        require_rustup
        echo "building $rust_crate_root wheel into $wheel_dir ..."
        local wheel_out
        wheel_out="$(realpath -m "$wheel_dir")"
        (cd "$rust_crate_root" && maturin build --release --out "$wheel_out")
    fi
    echo "installing $rust_crate_root wheel from $wheel_dir ..."
    python -m pip install --force-reinstall --no-deps "$wheel_dir"/*.whl
    echo "... installed $rust_crate_root wheel"
}


setup () {

    # Both flags are for CI:
    # --no-os-packages: python3-tk isn't used there (apt installs it into the system python,
    #   not setup-python's), so CI skips apt.
    # --rust-wheel-dir <dir>: install rust/ from a cached wheel (see install_rust_wheel)
    #   instead of `maturin develop`.
    local os_packages=true
    local rust_wheel_dir=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --no-os-packages) os_packages=false; shift ;;
            --rust-wheel-dir) rust_wheel_dir="$2"; shift 2 ;;
            *) usage; exit 1 ;;
        esac
    done

    if [ "$os_packages" = true ]; then
        install_os_packages
    fi
    init_submodules
    create_venv
    activate_venv
    install_and_upgrade_pip
    install_python_modules
    install_maturin
    install_ruff
    if [ -n "$rust_wheel_dir" ]; then
        install_rust_wheel "$rust_wheel_dir"
    else
        build_rust
    fi
    fetch_data
    deactivate_venv
}

run_tests () {

    activate_venv
    # tests/ (this package's own tests) and $rust_crate_root/tests/ (the Rust crate's own
    # Python-facing parity/correctness tests, e.g. test_fused_layer_ops.py) are both real,
    # committed test suites - pytest with no path argument happens to collect both when run
    # from the repo root (no testpaths config restricts it), which is how some past PRs' own
    # test-plan counts (~1650+) included both without anyone noticing only one was ever run
    # here or in CI. Listed explicitly so both actually run every time, not by accident.
    # Paths given (e.g. `./cli test rust/tests/`) run just those - CI runs each suite as its own
    # parallel job this way, so the short rust/tests/ job finishes inside the long tests/ one.
    if [ "$#" -eq 0 ]; then
        set -- tests/ "$rust_crate_root/tests/"
    fi
    python3 -m pytest --verbose "$@"
    deactivate_venv
}

lint () {

    # the checks CI's lint job runs; `ruff check --fix . && ruff format .` applies the fixable ones
    activate_venv
    ruff check .
    ruff format --check .
    deactivate_venv
}

demo () {

    activate_venv
    python3 -m indrajala_ml.demos.menu "$@"
    deactivate_venv
}

usage () {
    echo "usage: invoke [ clean | setup [--no-os-packages] [--rust-wheel-dir <dir>] | build-rust | fetch-data | test [pytest-path ...] | lint | demo [demo-number] ]"
}

case "$option" in

    clean)
        clean
    ;;

    setup)
        shift
        setup "$@"
    ;;

    build-rust)
        activate_venv
        build_rust
        deactivate_venv
    ;;

    fetch-data)
        activate_venv
        fetch_data
        deactivate_venv
    ;;

    test)
        shift
        clean
        run_tests "$@"
    ;;

    lint)
        lint
    ;;

    demo)
        shift
        demo "$@"
    ;;

    *)
        usage
    ;;
esac
