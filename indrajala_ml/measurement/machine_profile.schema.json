{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine profile",
  "description": "The benchmark machine's profile (indrajala_ml/measurement/machine_profile.py). identity is compared between profiles; state is recorded only; noise_rules, set by hand from the machine's A/As, are the thresholds scripts/ab.py reports by on that machine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory",
        "gpus",
        "os",
        "software"
      ],
      "properties": {
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vendor",
            "model_name",
            "architecture",
            "sockets",
            "physical_cores",
            "logical_cpus",
            "threads_per_core",
            "caches",
            "isa",
            "frequency",
            "power_limits",
            "firmware_throttled"
          ],
          "properties": {
            "vendor": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "architecture": {
              "type": "string"
            },
            "sockets": {
              "type": [
                "integer",
                "null"
              ]
            },
            "physical_cores": {
              "type": [
                "integer",
                "null"
              ]
            },
            "logical_cpus": {
              "type": [
                "integer",
                "null"
              ]
            },
            "threads_per_core": {
              "type": [
                "integer",
                "null"
              ]
            },
            "caches": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "level",
                  "type",
                  "size_kib",
                  "shared_by_logical_cpus",
                  "instances"
                ],
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "type": {
                    "type": "string"
                  },
                  "size_kib": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "shared_by_logical_cpus": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "instances": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "isa": {
              "description": "the architecture's ISA extensions a kernel could select (machine_profile_capture.ISA_FLAGS), each present or not",
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "frequency": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "driver",
                "governor",
                "min_mhz",
                "max_mhz",
                "scaling_min_mhz",
                "scaling_max_mhz",
                "boost_enabled",
                "energy_performance_preference",
                "intel_pstate_status"
              ],
              "properties": {
                "driver": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "governor": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "min_mhz": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "max_mhz": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "scaling_min_mhz": {
                  "description": "cpu0's cpufreq/scaling_min_freq: the policy's lower limit",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "scaling_max_mhz": {
                  "description": "cpu0's cpufreq/scaling_max_freq: the policy's upper limit, below max_mhz when the clock is capped",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "boost_enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "energy_performance_preference": {
                  "description": "cpu0's cpufreq/energy_performance_preference (EPP), null where the driver has none",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "intel_pstate_status": {
                  "description": "intel_pstate/status (active, passive, off), null without intel_pstate",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "power_limits": {
              "description": "RAPL package-0's power limits in watts (PL1 long_term, PL2 short_term), null without RAPL",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "long_term_w",
                "short_term_w"
              ],
              "properties": {
                "long_term_w": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "short_term_w": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            },
            "firmware_throttled": {
              "description": "the Raspberry Pi firmware's throttle flags (vcgencmd get_throttled; bits 0-3 now, 16-19 since boot); 0 is never throttled since boot, null on any other machine",
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_mib",
            "swap_total_mib"
          ],
          "properties": {
            "total_mib": {
              "type": [
                "integer",
                "null"
              ]
            },
            "swap_total_mib": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "vendor",
              "device"
            ],
            "properties": {
              "class": {
                "type": "string"
              },
              "vendor": {
                "type": "string"
              },
              "device": {
                "type": "string"
              }
            }
          }
        },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "kernel_release",
            "distribution",
            "perf_event_paranoid"
          ],
          "properties": {
            "system": {
              "type": "string"
            },
            "kernel_release": {
              "type": "string"
            },
            "distribution": {
              "type": [
                "string",
                "null"
              ]
            },
            "perf_event_paranoid": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "numpy",
            "rustc",
            "crate_release_profile",
            "thread_env"
          ],
          "properties": {
            "python": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "implementation",
                "version"
              ],
              "properties": {
                "implementation": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              }
            },
            "numpy": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "version",
                "blas"
              ],
              "properties": {
                "version": {
                  "type": "string"
                },
                "blas": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "version",
                    "configuration"
                  ],
                  "properties": {
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "configuration": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "rustc": {
              "type": [
                "string",
                "null"
              ]
            },
            "crate_release_profile": {
              "description": "rust/Cargo.toml's [profile.release] table, \"default\" if it sets none, null if the crate is missing",
              "oneOf": [
                {
                  "const": "default"
                },
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "thread_env": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "OPENBLAS_NUM_THREADS",
                "OMP_NUM_THREADS",
                "MKL_NUM_THREADS",
                "RAYON_NUM_THREADS"
              ],
              "properties": {
                "OPENBLAS_NUM_THREADS": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "OMP_NUM_THREADS": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "MKL_NUM_THREADS": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "RAYON_NUM_THREADS": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "hostname",
        "load_average",
        "memory_available_mib",
        "cpu_mhz_now",
        "power",
        "commits"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "hostname": {
          "type": "string"
        },
        "load_average": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "memory_available_mib": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cpu_mhz_now": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          }
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on_ac",
            "battery_percent"
          ],
          "properties": {
            "on_ac": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "battery_percent": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "commits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "repo_dirty",
            "rust"
          ],
          "properties": {
            "repo": {
              "type": [
                "string",
                "null"
              ]
            },
            "repo_dirty": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "rust": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "noise_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shifted_pass",
        "high_load",
        "small_consistent",
        "measured_by"
      ],
      "properties": {
        "shifted_pass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "a pass this far from its side's pooled medians (a fraction) is shifted"
        },
        "high_load": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "a pre-flight 1-minute load average above this is flagged"
        },
        "small_consistent": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "a consistent row under this |delta| (a fraction) is marked small: chance level in this machine's A/As"
        },
        "measured_by": {
          "type": "string",
          "description": "where the values come from"
        }
      }
    },
    "thermal": {
      "description": "optional, set by hand: the machine's thermal limits, which scripts/ab.py holds every pass to (litshe's: the owner's rule for the Raspberry Pi 5). A pass waits for the CPU to cool below start_below_c, is stopped over abort_c and fails over max_c; the limits are inclusive.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_c",
        "abort_c",
        "start_below_c",
        "set_by"
      ],
      "properties": {
        "max_c": {
          "type": "number"
        },
        "abort_c": {
          "type": "number"
        },
        "start_below_c": {
          "type": "number"
        },
        "set_by": {
          "type": "string"
        }
      }
    }
  }
}
